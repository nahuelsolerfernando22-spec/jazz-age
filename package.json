{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "cuervo": {
    "versionName": "1.0.0",
    "versionCode": 5
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-purged-routes.mjs && vite build",
    "build:dev": "node scripts/check-purged-routes.mjs && vite build --mode development",
    "build:apk": "node scripts/check-purged-routes.mjs && node scripts/check-asset-weight.mjs && node scripts/check-asset-pixels.mjs && APK_BUILD=1 vite build && node scripts/bundle-assets-apk.mjs dist/client && node scripts/offline-audit.mjs && node scripts/apk-prod-audit.mjs && node scripts/apk-bump-version.mjs && cap sync android && node scripts/apk-android-patch.mjs && node scripts/apk-manifest-audit.mjs",
    "apk:bump": "node scripts/apk-bump-version.mjs",
    "check:apk": "node scripts/offline-audit.mjs && node scripts/apk-prod-audit.mjs && node scripts/apk-manifest-audit.mjs",
    "apk:sync": "bunx cap sync android && node scripts/apk-android-patch.mjs",
    "apk:open": "bunx cap open android",
    "apk:smoke": "node scripts/apk-smoke.mjs",
    "apk:startup": "node scripts/apk-startup-audit.mjs",
    "apk:logs": "node scripts/apk-logcat.mjs --offline",
    "apk:release": "bun run build:apk && bunx cap open android",
    "check:purged": "node scripts/check-purged-routes.mjs",
    "check:canon": "node scripts/check-canon.mjs",
    "check:portraits": "node scripts/check-portraits-offline.mjs",
    "check:orphans": "node scripts/check-orphan-assets.mjs",
    "check:offline": "node scripts/offline-audit.mjs",
    "check:weight": "node scripts/check-asset-weight.mjs",
    "check:all": "node scripts/check-portraits-offline.mjs && node scripts/check-orphan-assets.mjs && node scripts/check-asset-weight.mjs && node scripts/check-asset-pixels.mjs",
    "check:coldstart": "node scripts/coldstart-audit.mjs",
    "shots:store": "node scripts/store-screenshots.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:maps": "python3 scripts/verify-maps.py",
    "check:pixels": "node scripts/check-asset-pixels.mjs",
    "build:apk:strict": "APK_STRICT=1 bun run build:apk",
    "e2e": "playwright test",
    "e2e:mahjong": "playwright test mahjong --project=chromium-android-375",
    "qa:offline": "node scripts/offline-playthrough.mjs",
    "apk:keystore": "node scripts/apk-keystore.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@cloudflare/vite-plugin": "^1.25.5",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@supabase/supabase-js": "^2.106.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.14",
    "@tanstack/router-plugin": "^1.167.10",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.575.0",
    "nitro": "3.0.260603-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-plugin-hmr-gate": "^1.3.4",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "lovable-tagger": "^1.3.3",
    "prettier": "^3.7.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tanstack-config": "npm:@lovable.dev/vite-tanstack-config@2.7.7",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.1"
  }
}
